# Текстовые шаги (копирайтер, арт-директор, QA). Любой OpenAI-совместимый API.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Фоны. Пусто → процедурные фоны в фирменных цветах.
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=gpt-image-1

# Браузер для вёрстки. Пусто → ищется Chrome или Edge автоматически
CHROMIUM_PATH=

# Бренд по умолчанию — если в ТЗ не указан (цвета: фон, акцент, доп.)
BRAND_NAME=
BRAND_COLORS=#0F172A,#F97316,#6366F1
BRAND_STYLE=минимализм, мягкий свет

# Порт веб-интерфейса
PORT=3000
