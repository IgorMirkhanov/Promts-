# Текстовые шаги (разбор ТЗ, копирайтер, QA). Gemini через OpenAI-совместимый эндпоинт.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Пароль на веб-интерфейс. На Vercel обязателен.
APP_PASSWORD=

# Бренд по умолчанию — если в ТЗ не указан (цвета: фон, акцент, доп.)
BRAND_NAME=
BRAND_COLORS=#0F172A,#F97316,#6366F1
BRAND_STYLE=минимализм, мягкий свет

# Порт локального веб-интерфейса
PORT=3000
