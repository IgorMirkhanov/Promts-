# Текстовые шаги (копирайтер, арт-директор, QA). Любой OpenAI-совместимый API.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Фоны. Пусто → процедурные фоны в фирменных цветах.
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=gpt-image-1

# Путь к Chromium, если не установлен через `npx playwright install chromium`
CHROMIUM_PATH=
